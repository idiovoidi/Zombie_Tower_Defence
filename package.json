{
  "name": "z-td",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://idiovoidi.github.io/Zombie_Tower_Defence/",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "server": "node server.js",
    "build": "npm run quality && tsc && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "type-check": "tsc --noEmit",
    "dupcheck": "jscpd src --format \"typescript,javascript\" --min-lines 8 --min-tokens 60 --reporters console",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "deps:report": "depcruise src --config .dependency-cruiser.cjs --output-type html > dependency-report.html",
    "dev:debug": "vite --debug",
    "clean": "node scripts/safe-clean.js",
    "clean:dry-run": "node scripts/safe-clean.js --dry-run",
    "knip": "knip",
    "eslint": "eslint \"src/**/*.ts\"",
    "eslint:fix": "eslint \"src/**/*.ts\" --fix",
    "quality": "biome check . && tsc --noEmit && eslint \"src/**/*.ts\" && depcruise src --config .dependency-cruiser.cjs",
    "quality:full": "npm run quality && npm run knip && npm run dupcheck"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pixi.js": "^8.23.0",
    "regression": "^2.0.1",
    "simple-statistics": "^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "concurrently": "^10.0.7",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.5",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "knip": "^6.48.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
